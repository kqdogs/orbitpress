---
import type { Settings } from '../lib/schema';
import { initialPageLayout } from '../lib/page-layouts';
import ContentLayout from './page-layout/ContentLayout.astro';
import AdSlot from './AdSlot.astro';
const {settings,builder=false}=Astro.props as {settings:Settings;builder?:boolean};
---
<ContentLayout layout={initialPageLayout(settings,'home')} settings={settings} builder={builder} home/>
<div class="container"><AdSlot settings={settings} placement="home" preview={builder}/></div>
