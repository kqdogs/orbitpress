---
import type { HomeComponentProps } from '../../lib/home-components';
import PostCard from '../PostCard.astro';
import HomeSectionHeading from '../HomeSectionHeading.astro';
const {settings,block,data}=Astro.props as HomeComponentProps;
const videos={items:data.videos}; const totalVideos=data.totalVideos;
---
{true&&<section class="container content-section"><HomeSectionHeading section={{title:block.title,subtitle:block.text}} href="/videos/" linkText={`全部 ${totalVideos} 个视频 →`}/><div class="post-grid home-video-grid">{videos.items.map(post=><PostCard post={post} author={settings.title} settings={settings}/>)}</div></section>}
