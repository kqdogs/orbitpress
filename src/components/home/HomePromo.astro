---
import {translator} from '../../lib/i18n';
const t=translator(Astro.locals.locale);
import type { HomeComponentProps } from '../../lib/home-components';
import Icon from '../Icon.astro';
const {settings,block}=Astro.props as HomeComponentProps;
const config=settings.homeOptions;
---
{true&&<div class="container home-content"><a class="promo-banner" href={config.promoHref}><div><small> {t("CardWiki · 虚拟卡百科")} </small><h2>{block.title}</h2><p>{block.text}</p></div><span> {t("前往百科")} <Icon name="arrow"/></span></a></div>}
