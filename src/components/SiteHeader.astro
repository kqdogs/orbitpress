---
import {translator} from '../lib/i18n';
const t=translator(Astro.locals.locale);
import type { Settings } from '../lib/schema';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { brandLogo } from '../lib/branding';
import BrandBackdrop from './BrandBackdrop.astro';
import {headerNavigation} from '../lib/header-navigation';
import HeaderActions from './HeaderActions.astro';
interface Props { settings: Settings; pathname: string }
const { settings, pathname } = Astro.props;
const logo = brandLogo(settings);
const navItems=headerNavigation(settings,Astro.locals.locale);
---
<header class="site-header"><BrandBackdrop/>
 <div class="brand-row container"><button class="mobile-menu icon-button" aria-label={t("打开导航")} aria-expanded="false"><Icon name="menu"/></button><a class="brand" href="/"><img src={logo} alt="" width="64" height="64"/><div class="brand-copy"><strong>{settings.title}</strong><span>{settings.tagline}</span></div></a><SocialLinks settings={settings} variant="header"/><div class="mobile-actions"><HeaderActions/></div></div>
 <div class="nav-band"><div class="container nav-row"><nav class="nav-links" aria-label={t("主导航")}>{navItems.map(item=><a class:list={[{active:pathname===item.href, 'wiki-link':item.accent}]} href={item.href}>{item.badge&&<small>{item.badge}</small>}{item.accent&&<Icon name="card" size={16}/>} {item.label}{item.accent&&' ↗'}</a>)}</nav><div class="desktop-actions"><HeaderActions/></div></div></div>
</header>
<script>
 const menu=document.querySelector<HTMLButtonElement>('.mobile-menu')!;
 menu.addEventListener('click',()=>{const expanded=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!expanded));document.querySelector('.nav-band')?.classList.toggle('is-open',!expanded);});
</script>
<style>
 .mobile-actions{display:none}
 .desktop-actions{flex-shrink:0;margin-inline-start:auto}
 @media(max-width:760px){
  .desktop-actions{display:none}
  .mobile-actions{display:block;position:absolute;right:-4px;top:35px}
  .brand-row{justify-content:flex-start;padding-left:36px;padding-right:84px}
  .brand{min-width:0;max-width:100%}
  .brand img{flex-shrink:0}
 }
</style>
