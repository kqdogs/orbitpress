---
interface Props {variant?:'header'|'footer'}
const {variant='header'}=Astro.props;
---
<div class:list={['brand-backdrop',`brand-backdrop-${variant}`]} data-motion-paused="true" aria-hidden="true">
 <div class="brand-aurora brand-aurora-blue"></div>
 <div class="brand-aurora brand-aurora-violet"></div>
 <div class="brand-horizon"></div>
 <svg class="brand-orbits" viewBox="0 0 1000 320" fill="none" preserveAspectRatio="none">
  <g transform="rotate(-12 500 160)">
   <ellipse class="orbit-track" cx="500" cy="160" rx="460" ry="98"/>
   <ellipse class="orbit-trail" cx="500" cy="160" rx="460" ry="98" pathLength="1000"/>
   <ellipse class="orbit-tip" cx="500" cy="160" rx="460" ry="98" pathLength="1000"/>
  </g>
  <g class="orbit-secondary" transform="rotate(12 500 160)">
   <ellipse class="orbit-track" cx="500" cy="160" rx="420" ry="122"/>
   <ellipse class="orbit-trail" cx="500" cy="160" rx="420" ry="122" pathLength="1000"/>
   <ellipse class="orbit-tip" cx="500" cy="160" rx="420" ry="122" pathLength="1000"/>
  </g>
 </svg>
 <canvas class="brand-starfield" data-brand-sky={variant}></canvas>
</div>
<script>
 // Decorative only: no network, pointer capture or content state.
 document.querySelectorAll<HTMLCanvasElement>('[data-brand-sky]').forEach(canvas=>{
  const context=canvas.getContext('2d');if(!context)return;
  const atmosphere=canvas.parentElement!;
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  const footer=canvas.dataset.brandSky==='footer';
  let width=0,height=0,frame=0,last=0,elapsed=0,visible=false,disposed=false;
  const stars=Array.from({length:100},(_,index)=>({x:Math.random(),y:Math.random(),radius:.5+Math.random()*1.1,speed:2+Math.random()*5,phase:index*1.7}));
  const meteors=[{period:4200,offset:0,x:.12,y:.05},{period:5900,offset:2100,x:.58,y:.1},{period:7300,offset:4600,x:.35,y:.28}];
  function paint(time:number){
   if(width<=0||height<=0)return;
   context!.clearRect(0,0,width,height);
   const count=Math.min(stars.length,Math.max(30,Math.round(width*height/3600)));
   for(let index=0;index<count;index++){
    const star=stars[index];
    const x=(star.x*width+time*star.speed*.001)%width;
    const y=star.y*height+Math.sin(time*.0004+star.phase)*3;
    const alpha=.3+(Math.sin(time*.0015+star.phase)+1)*.3;
    context!.fillStyle=`rgba(198,226,255,${alpha})`;
    if(index%9===0){context!.shadowColor='#69bdff';context!.shadowBlur=8;}
    context!.beginPath();context!.arc(x,y,star.radius,0,Math.PI*2);context!.fill();context!.shadowBlur=0;
    if(index%17===0){context!.strokeStyle=`rgba(183,223,255,${alpha*.55})`;context!.lineWidth=.7;context!.beginPath();context!.moveTo(x-4,y);context!.lineTo(x+4,y);context!.moveTo(x,y-4);context!.lineTo(x,y+4);context!.stroke();}
   }
   if(!reduced.matches){
    for(const meteor of meteors){
     const progress=((time+meteor.offset)%meteor.period)/1600;
     if(progress>=1)continue;
     const fade=Math.sin(progress*Math.PI);
     const distance=Math.min(width*.42,520);
     const x=width*meteor.x+progress*distance,y=height*meteor.y+progress*(footer?height*.62:height*.48);
     const tail=Math.min(150,width*.22),rise=tail*.32;
     const gradient=context!.createLinearGradient(x-tail,y-rise,x,y);
     gradient.addColorStop(0,'rgba(99,164,255,0)');gradient.addColorStop(.65,`rgba(100,189,255,${fade*.4})`);gradient.addColorStop(1,`rgba(225,246,255,${fade})`);
     context!.strokeStyle=gradient;context!.lineWidth=1.8;context!.beginPath();context!.moveTo(x-tail,y-rise);context!.lineTo(x,y);context!.stroke();
     context!.fillStyle=`rgba(235,248,255,${fade})`;context!.shadowColor='#7acbff';context!.shadowBlur=14;context!.beginPath();context!.arc(x,y,1.8,0,Math.PI*2);context!.fill();context!.shadowBlur=0;
    }
   }
  }
  function tick(time:number){frame=0;if(disposed||!visible||document.hidden||reduced.matches)return;if(time-last>=32){elapsed+=Math.min(time-last,64);paint(elapsed);last=time;}frame=requestAnimationFrame(tick);}
  function schedule(){cancelAnimationFrame(frame);frame=0;const paused=disposed||!visible||document.hidden||reduced.matches;atmosphere.dataset.motionPaused=String(paused);if(!disposed&&visible&&!document.hidden){paint(reduced.matches?0:elapsed);last=performance.now();if(!reduced.matches)frame=requestAnimationFrame(tick);}}
  function resize(){const rect=canvas.getBoundingClientRect();width=rect.width;height=rect.height;const ratio=Math.min(devicePixelRatio||1,1.5);canvas.width=Math.round(width*ratio);canvas.height=Math.round(height*ratio);context!.setTransform(ratio,0,0,ratio,0,0);schedule();}
  const resizeObserver=new ResizeObserver(resize);resizeObserver.observe(canvas);
  const observer=new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;schedule();});observer.observe(canvas);
  const visibility=()=>schedule();document.addEventListener('visibilitychange',visibility);reduced.addEventListener('change',visibility);
  window.addEventListener('pagehide',event=>{cancelAnimationFrame(frame);if(event.persisted)return;disposed=true;resizeObserver.disconnect();observer.disconnect();document.removeEventListener('visibilitychange',visibility);reduced.removeEventListener('change',visibility);});
  window.addEventListener('pageshow',event=>{if(event.persisted)schedule();});
 });
</script>
