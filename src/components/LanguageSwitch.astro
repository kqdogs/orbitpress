---
import {locales,localeNames,translator} from '../lib/i18n';
import Icon from './Icon.astro';
const locale=Astro.locals.locale,t=translator(locale);
---
<details class="site-language" data-site-language>
 <summary aria-label={`${t('切换语言')}: ${localeNames[locale]}`}>
  <Icon name="globe" size={16} class="language-globe"/>
  <span class="language-label">{locale==='en'?'EN':'中文'}</span>
  <svg class="language-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg>
 </summary>
 <div class="language-options">
  {locales.map(item=><button type="button" lang={item} data-language-option={item} aria-pressed={item===locale}><span>{localeNames[item]}</span><span class="language-check" aria-hidden="true">{item===locale?'✓':''}</span></button>)}
 </div>
</details>
<script>
 import {changeLocale} from '../lib/i18n/client';
 document.querySelectorAll('[data-site-language]').forEach(element=>{
  if(!(element instanceof HTMLDetailsElement))return;
  const trigger=element.querySelector('summary');
  element.querySelectorAll<HTMLButtonElement>('[data-language-option]').forEach(button=>{
   button.addEventListener('click',()=>{
    const locale=button.dataset.languageOption;
    if(locale!=='en'&&locale!=='zh-CN')return;
    element.open=false;
    trigger?.focus();
    changeLocale(locale);
   });
  });
  document.addEventListener('pointerdown',event=>{
   if(element.open&&event.target instanceof Node&&!element.contains(event.target))element.open=false;
  });
  document.addEventListener('keydown',event=>{
   if(event.key==='Escape'&&element.open){element.open=false;trigger?.focus();event.preventDefault();}
  });
 });
</script>
<style>
 .site-language{position:relative;flex-shrink:0;color:#dce9fb;font-size:12px;line-height:1.4}
 summary{display:flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:7px 10px;border:1px solid #ffffff20;border-radius:10px;background:#ffffff06;cursor:pointer;list-style:none;transition:background .15s,border-color .15s;user-select:none}
 summary::-webkit-details-marker{display:none}
 summary:hover,.site-language[open] summary{background:#ffffff12;border-color:#8cbcf775}
 summary:focus-visible{outline:3px solid #73a6ff;outline-offset:3px}
 .language-label{font-weight:600;white-space:nowrap}
 .language-chevron{transition:transform .15s}
 .site-language[open] .language-chevron{transform:rotate(180deg)}
 .language-options{position:absolute;inset-inline-end:0;top:calc(100% + 9px);z-index:40;width:168px;padding:5px;border:1px solid #44618a80;border-radius:12px;background:#10213c;box-shadow:0 14px 36px #02091566;animation:language-enter .15s ease-out}
 .language-options button{display:flex;align-items:center;justify-content:space-between;gap:20px;width:100%;min-height:40px;padding:9px 11px;border:0;border-radius:8px;background:transparent;color:#dce9fb;font-size:13px;text-align:start;white-space:nowrap}
 .language-options button:hover,.language-options button:focus-visible{background:#ffffff12;color:#fff}
 .language-options button[aria-pressed=true]{background:#369ce91c;color:#8dd5ff;font-weight:600}
 .language-check{width:14px}
 @keyframes language-enter{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}
 @media(max-width:760px){summary{width:36px;padding:7px}.language-globe,.language-chevron{display:none}}
 @media(prefers-reduced-motion:reduce){summary,.language-chevron{transition:none}.language-options{animation:none}}
</style>
