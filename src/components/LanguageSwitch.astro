---
import {locales,localeNames} from '../lib/i18n';
const locale=Astro.locals.locale;
---
<label class="site-language"><span class="sr-only">Language / 语言</span><select aria-label="Language / 语言" data-site-language>{locales.map(item=><option value={item} selected={item===locale}>{localeNames[item]}</option>)}</select></label>
<script>
 import {changeLocale} from '../lib/i18n/client';
 document.querySelectorAll('[data-site-language]').forEach(element=>{
  if(element instanceof HTMLSelectElement)element.addEventListener('change',()=>changeLocale(element.value==='en'?'en':'zh-CN'));
 });
</script>
<style>.site-language select{font:inherit;font-size:12px;color:inherit;background:transparent;border:1px solid currentColor;border-radius:6px;padding:4px;max-width:105px;cursor:pointer}.site-language option{color:#16202e;background:#fff}.site-language{display:inline-flex;align-items:center;margin-left:auto}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}</style>
