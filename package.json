{
  "name": "orbitpress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check && tsc --noEmit && vue-tsc --noEmit -p tsconfig.studio.json",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply blog-db --local",
    "db:seed": "node scripts/seed.mjs",
    "setup:local": "node scripts/setup.mjs",
    "setup:production": "node scripts/deploy.mjs --setup",
    "deploy:check": "node scripts/deploy.mjs --check",
    "deploy": "node scripts/deploy-button.mjs",
    "deploy:cli": "node scripts/deploy.mjs",
    "test": "vitest run",
    "test:ads": "node scripts/advertising-integration.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:studio": "node scripts/studio-integration.mjs"
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.1",
    "@ant-design/fast-color": "^3.0.1",
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/vue": "^7.0.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^15.0.0",
    "astro": "7.3.8",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.0",
    "htmlparser2": "12.0.0",
    "lodash-es": "^4.18.1",
    "marked": "^16.4.1",
    "resize-observer-polyfill": "^1.5.1",
    "sanitize-html": "^2.17.0",
    "sortablejs": "^1.15.7",
    "vue": "3.5.42",
    "vue-router": "^4.6.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.18.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "sass": "^1.105.2",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.151.1"
  }
}
